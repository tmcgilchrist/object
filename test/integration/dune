(rule
 (target xcrun.lipo-verify_arch.expected)
 (enabled_if
  (and
   (= %{system} "macosx")
   (= %{architecture} "arm64")))
 (action
  (with-stdout-to
   %{target}
   (run lipo /usr/bin/xcrun -verify_arch x86_64 arm64e))))

(rule
 (target xcrun.lipo-verify_arch.output)
 (deps %{exe:../../example/oclipo.exe})
 (enabled_if
  (and
   (= %{system} "macosx")
   (= %{architecture} "arm64")))
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:../../example/oclipo.exe}
    --verify_arch
    x86_64
    --verify_arch
    arm64e
    /usr/bin/xcrun))))

(rule
 (alias integration)
 (enabled_if
  (and
   (= %{system} "macosx")
   (= %{architecture} "arm64")))
 (action
  (diff xcrun.lipo-verify_arch.expected xcrun.lipo-verify_arch.output)))

